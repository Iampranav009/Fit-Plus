        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().clientUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedSlots', 'items', 'waterGlasses', 'personalNotes', 'updatedAt'
            ])
          ) ||
          (
            existing().trainerUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'trainerFeedback', 'trainerFeedbackAt', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /weeklyCheckIns/{checkInId} (Stage 4A Weekly Check-Ins & Coach Feedback)
    // -------------------------------------------------------------------------
    match /weeklyCheckIns/{checkInId} {
      allow get: if isSignedIn() && isValidId(checkInId) && (
        existing().clientUserId == request.auth.uid ||
        existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(checkInId)
        && isValidWeeklyCheckIn(incoming(), checkInId)
        && incoming().clientUserId == request.auth.uid
        && !('trainerFeedback' in incoming())
        && !('trainerReviewedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(checkInId)
        && isValidWeeklyCheckIn(incoming(), checkInId)
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().weekKey == existing().weekKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().clientUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'weightKg', 'energyLevel', 'sleepQuality', 'workoutDifficulty', 'hungerLevel',
              'scheduleChallenges', 'generalFeedback', 'photoPath', 'shareWithTrainer', 'updatedAt'
            ])
          ) ||
          (
            existing().trainerUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'trainerFeedback', 'trainerReviewedAt', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /conversations/{conversationId} (Stage 4B Real-Time FitPlus Connect)
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (
        existing().clientUserId == request.auth.uid ||
        existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(conversationId)
        && isValidChatConversation(incoming(), conversationId)
        && (incoming().clientUserId == request.auth.uid || incoming().trainerUserId == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(conversationId)
        && isValidChatConversation(incoming(), conversationId)
        && (existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid)
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().trainerId == existing().trainerId
        && incoming().clientUserId == existing().clientUserId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if false;

      // -----------------------------------------------------------------------
      // /conversations/{conversationId}/messages/{messageId}
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId);
        allow list: if isSignedIn();

        allow create: if isVerifiedUser()
          && isValidId(messageId)
          && isValidChatMessage(incoming(), messageId)
          && incoming().senderUserId == request.auth.uid
          && incoming().conversationId == conversationId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.clientUserId == request.auth.uid ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.trainerUserId == request.auth.uid
          );

        allow update: if isSignedIn()
          && isValidId(messageId)
          && incoming().id == existing().id
          && incoming().conversationId == existing().conversationId
          && incoming().senderUserId == existing().senderUserId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'readAt']);

        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /workoutTemplates/{templateId} (Stage 4B Workout Studio Templates)
    // -------------------------------------------------------------------------
    match /workoutTemplates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId);
      allow list: if isSignedIn();

      allow create: if isVerifiedUser()
        && isValidId(templateId)
        && isValidWorkoutProgramTemplate(incoming(), templateId)
        && incoming().trainerUserId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(templateId)
        && isValidWorkoutProgramTemplate(incoming(), templateId)
        && existing().trainerUserId == request.auth.uid
        && incoming().trainerUserId == request.auth.uid
        && incoming().id == existing().id;

      allow delete: if isVerifiedUser()
        && isValidId(templateId)
        && existing().trainerUserId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /nutritionTemplates/{templateId} (Stage 4B Nutrition Studio Templates)
    // -------------------------------------------------------------------------
    match /nutritionTemplates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId);
      allow list: if isSignedIn();

      allow create: if isVerifiedUser()
        && isValidId(templateId)
        && isValidNutritionProgramTemplate(incoming(), templateId)
        && incoming().trainerUserId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(templateId)
        && isValidNutritionProgramTemplate(incoming(), templateId)
        && existing().trainerUserId == request.auth.uid
        && incoming().trainerUserId == request.auth.uid
        && incoming().id == existing().id;

      allow delete: if isVerifiedUser()
        && isValidId(templateId)
        && existing().trainerUserId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /scheduledReminders/{reminderId} (Stage 4B Client Pulse & Automations)
    // -------------------------------------------------------------------------
    match /scheduledReminders/{reminderId} {
      allow get: if isSignedIn() && isValidId(reminderId) && (
        existing().recipientUserId == request.auth.uid ||
        ('clientUserId' in existing() && existing().clientUserId == request.auth.uid) ||
        ('trainerUserId' in existing() && existing().trainerUserId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        resource.data.recipientUserId == request.auth.uid ||
        ('clientUserId' in resource.data && resource.data.clientUserId == request.auth.uid) ||
        ('trainerUserId' in resource.data && resource.data.trainerUserId == request.auth.uid)
      );

      allow create: if isVerifiedUser()
        && isValidId(reminderId)
        && isValidScheduledReminder(incoming(), reminderId);

      allow update: if isVerifiedUser()
        && isValidId(reminderId)
        && incoming().id == existing().id
        && (
          existing().recipientUserId == request.auth.uid ||
          ('trainerUserId' in existing() && existing().trainerUserId == request.auth.uid) ||
          ('clientUserId' in existing() && existing().clientUserId == request.auth.uid)
        );

      allow delete: if isVerifiedUser()
        && isValidId(reminderId)
        && (
          existing().recipientUserId == request.auth.uid ||
          ('trainerUserId' in existing() && existing().trainerUserId == request.auth.uid)
        );
    }
  }
}
