    // -------------------------------------------------------------------------
    // /admins/{userId} (Server-Provisioned Admins — Never Client-Writable)
    // -------------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list, create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} & Isolated Private PII Subcollection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().role in ['client', 'trainer']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUser(incoming(), userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId) &&
            existing().role != 'admin' &&
            incoming().role in ['client', 'trainer'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'role', 'timezone', 'isAdultConfirmed',
              'onboardingCompleted', 'privacyConsentAccepted', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin());

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateContact(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateContact(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'whatsappE164', 'celebratedDateKeys', 'pendingInviteToken',
            'notificationPrefs', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // /trainers/{trainerId} (Public Storefront — No Personal PII)
    // -------------------------------------------------------------------------
    match /trainers/{trainerId} {
      allow get: if isValidId(trainerId) && (
        existing().acceptingClients == true ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.acceptingClients == true || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(trainerId)
        && isValidTrainerProfile(incoming(), trainerId)
        && incoming().userId == request.auth.uid
        && incoming().isDemoVerified == false
        && (!('verificationStatus' in incoming()) || incoming().verificationStatus == 'unverified')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(trainerId)
        && isValidTrainerProfile(incoming(), trainerId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().isDemoVerified == existing().isDemoVerified
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().userId == request.auth.uid &&
            (
              (!('verificationStatus' in incoming()) && !('verificationStatus' in existing())) ||
              (('verificationStatus' in incoming()) && ('verificationStatus' in existing()) && incoming().verificationStatus == existing().verificationStatus) ||
              (incoming().verificationStatus == 'pending' && (!('verificationStatus' in existing()) || existing().verificationStatus == 'unverified'))
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'slug', 'displayName', 'headline', 'bio', 'coachingStyle', 'city',
              'coachingMode', 'specialties', 'languages', 'certifications',
              'experienceYears', 'avatarKey', 'coverKey', 'photoUrl',
              'whatsappBusinessE164', 'verificationStatus', 'acceptingClients',
              'isPublished', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /packages/{packageId}
    // -------------------------------------------------------------------------
    match /packages/{packageId} {
      allow get: if isValidId(packageId) && (
        existing().status == 'active' || (isSignedIn() && existing().trainerUserId == request.auth.uid)
      );
      allow list: if resource.data.status == 'active' || (isSignedIn() && resource.data.trainerUserId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(packageId)
        && isValidPackage(incoming(), packageId)
        && incoming().trainerUserId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && get(/databases/$(database)/documents/trainers/$(incoming().trainerId)).data.userId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(packageId)
        && isValidPackage(incoming(), packageId)
        && existing().trainerUserId == request.auth.uid
        && incoming().id == existing().id
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'summary', 'priceInr', 'cadence', 'durationDays',
            'consultationsIncluded', 'features', 'status', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isValidId(packageId) && isVerifiedUser() && existing().trainerUserId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /clients/{clientId} (Owner or Actively Linked Trainer via Master Gate)
    // -------------------------------------------------------------------------
    match /clients/{clientId} {
      allow get: if isSignedIn() && isValidId(clientId) && (
        existing().userId == request.auth.uid ||
        (
          existing().activeTrainerUserId == request.auth.uid &&
          existing().activeRelationshipId != '' &&
          exists(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)) &&
          get(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)).data.status == 'active' &&
          get(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)).data.trainerUserId == request.auth.uid &&
          get(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)).data.clientId == clientId
        )
      );

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.activeTrainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(clientId)
        && isValidClientProfile(incoming(), clientId)
        && incoming().userId == request.auth.uid
        && incoming().activeTrainerUserId == ''
        && incoming().activeRelationshipId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(clientId)
        && isValidClientProfile(incoming(), clientId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName', 'lastName', 'age', 'heightCm', 'weightKg', 'targetWeightKg',
              'primaryGoal', 'experienceLevel', 'daysPerWeek', 'environment',
              'equipment', 'dietaryPreference', 'dietaryNotes', 'foodAllergies',
              'healthLimitations', 'preferredLanguage', 'coachingPreferences', 'updatedAt'
            ])
          ) ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['activeTrainerUserId', 'activeRelationshipId', 'updatedAt']) &&
            (
              (incoming().activeTrainerUserId == '' && incoming().activeRelationshipId == '') ||
              (
                incoming().activeRelationshipId != '' &&
                existsAfter(/databases/$(database)/documents/relationships/$(incoming().activeRelationshipId)) &&
                getAfter(/databases/$(database)/documents/relationships/$(incoming().activeRelationshipId)).data.clientUserId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/relationships/$(incoming().activeRelationshipId)).data.trainerUserId == incoming().activeTrainerUserId &&
                getAfter(/databases/$(database)/documents/relationships/$(incoming().activeRelationshipId)).data.status == 'active'
              )
            )
          ) ||
          (
            existing().activeTrainerUserId == request.auth.uid &&
            existing().activeRelationshipId != '' &&
            exists(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)) &&
            get(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)).data.status == 'active' &&
            get(/databases/$(database)/documents/relationships/$(existing().activeRelationshipId)).data.trainerUserId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['coachNotes', 'updatedAt'])
          )
        );

      allow delete: if isValidId(clientId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // /relationships/{relationshipId} (Master Source of Truth)
    // -------------------------------------------------------------------------
    match /relationships/{relationshipId} {
      allow get: if isSignedIn() && isValidId(relationshipId) && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid || resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(relationshipId)
        && isValidRelationship(incoming(), relationshipId)
        && incoming().clientUserId == request.auth.uid
        && incoming().status in ['pending', 'active']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId))
        && get(/databases/$(database)/documents/clients/$(incoming().clientId)).data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && get(/databases/$(database)/documents/trainers/$(incoming().trainerId)).data.userId == incoming().trainerUserId;

      allow update: if isVerifiedUser()
        && isValidId(relationshipId)
        && isValidRelationship(incoming(), relationshipId)
        && existing().status != 'ended'
        && incoming().id == existing().id
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().startedAt == existing().startedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid)
        && (
          (existing().status == 'pending' && incoming().status == 'active' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'packageId', 'updatedAt'])) ||
          (existing().trainerUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['groupId', 'updatedAt'])) ||
          (incoming().status == 'ended' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']))
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /invites/{inviteId}
    // -------------------------------------------------------------------------
    match /invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        existing().trainerUserId == request.auth.uid ||
        existing().status == 'active' ||
        existing().redeemedByUserId == request.auth.uid
      );
      allow list: if isSignedIn() && resource.data.trainerUserId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidInvite(incoming(), inviteId)
        && incoming().trainerUserId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && get(/databases/$(database)/documents/trainers/$(incoming().trainerId)).data.userId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidInvite(incoming(), inviteId)
        && existing().status == 'active'
        && incoming().id == existing().id
        && incoming().token == existing().token
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().trainerUserId == request.auth.uid &&
            incoming().status in ['revoked', 'expired'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            incoming().status == 'redeemed' &&
            incoming().redeemedByUserId == request.auth.uid &&
            ('redeemedByClientId' in incoming()) &&
            incoming().redeemedByClientId != '' &&
            exists(/databases/$(database)/documents/clients/$(incoming().redeemedByClientId)) &&
            get(/databases/$(database)/documents/clients/$(incoming().redeemedByClientId)).data.userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'redeemedByClientId', 'redeemedByUserId', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /enrollments/{enrollmentId}
    // -------------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && isValidId(enrollmentId) && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid || resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(enrollmentId)
        && isValidEnrollment(incoming(), enrollmentId)
        && incoming().clientUserId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId))
        && get(/databases/$(database)/documents/clients/$(incoming().clientId)).data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/packages/$(incoming().packageId))
        && get(/databases/$(database)/documents/packages/$(incoming().packageId)).data.trainerId == incoming().trainerId;

      allow update: if isVerifiedUser()
        && isValidId(enrollmentId)
        && isValidEnrollment(incoming(), enrollmentId)
        && existing().status != 'ended'
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().packageId == existing().packageId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid)
        && incoming().status == 'ended'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /clientGroups/{groupId} & /members/{clientId} (Master Gate Sync)
    // -------------------------------------------------------------------------
    match /clientGroups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId) && existing().trainerUserId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.trainerUserId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(groupId)
        && isValidClientGroup(incoming(), groupId)
        && incoming().trainerUserId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && get(/databases/$(database)/documents/trainers/$(incoming().trainerId)).data.userId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(groupId)
        && isValidClientGroup(incoming(), groupId)
        && existing().trainerUserId == request.auth.uid
        && incoming().id == existing().id
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);

      allow delete: if isValidId(groupId) && isVerifiedUser() && existing().trainerUserId == request.auth.uid;

      match /members/{clientId} {
        allow get: if isSignedIn() && isValidId(groupId) && isValidId(clientId) && (
          existing().trainerUserId == request.auth.uid || existing().clientUserId == request.auth.uid
        );
        allow list: if isSignedIn() && (
          resource.data.trainerUserId == request.auth.uid || resource.data.clientUserId == request.auth.uid
        );

        allow create: if isVerifiedUser()
          && isValidId(groupId)
          && isValidId(clientId)
          && isValidClientGroupMember(incoming(), clientId)
          && incoming().trainerUserId == request.auth.uid
          && incoming().addedAt == request.time
          && exists(/databases/$(database)/documents/clientGroups/$(groupId))
          && get(/databases/$(database)/documents/clientGroups/$(groupId)).data.trainerUserId == request.auth.uid
          && exists(/databases/$(database)/documents/clients/$(clientId))
          && get(/databases/$(database)/documents/clients/$(clientId)).data.activeTrainerUserId == request.auth.uid;

        allow update: if false;
        allow delete: if isValidId(groupId) && isValidId(clientId) && isVerifiedUser() && existing().trainerUserId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // /subscriptions/{subscriptionId} & /payments/{paymentId} (Server-Written Only)
    // -------------------------------------------------------------------------
    match /subscriptions/{subscriptionId} {
      allow get: if isSignedIn() && isValidId(subscriptionId) && (
        existing().clientUserId == request.auth.uid ||
        existing().trainerUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && (
        existing().clientUserId == request.auth.uid ||
        existing().trainerUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid ||
        resource.data.trainerUserId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // /templates/{templateId}
    // -------------------------------------------------------------------------
    match /templates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && existing().trainerUserId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.trainerUserId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(templateId)
        && isValidTaskTemplate(incoming(), templateId)
        && incoming().trainerUserId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && get(/databases/$(database)/documents/trainers/$(incoming().trainerId)).data.userId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(templateId)
        && isValidTaskTemplate(incoming(), templateId)
        && existing().trainerUserId == request.auth.uid
        && incoming().id == existing().id
        && incoming().trainerId == existing().trainerId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'instructions', 'durationMinutes', 'completionType',
            'targetLabel', 'isRecoveryDefault', 'isOptionalDefault', 'archived', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt'])
        );

      allow delete: if isValidId(templateId) && isVerifiedUser() && existing().trainerUserId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /assignments/{assignmentId}
    // -------------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid || resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming(), assignmentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId))
        && get(/databases/$(database)/documents/clients/$(incoming().clientId)).data.userId == incoming().clientUserId
        && (
          (incoming().clientUserId == request.auth.uid && incoming().trainerUserId == '') ||
          (
            incoming().trainerUserId == request.auth.uid &&
            get(/databases/$(database)/documents/clients/$(incoming().clientId)).data.activeTrainerUserId == request.auth.uid
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming(), assignmentId)
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'instructions', 'durationMinutes', 'dueTime',
          'completionType', 'targetLabel', 'scheduledDates', 'isOptional',
          'isRecovery', 'hasCustomOverride', 'overrideNote', 'updatedAt'
        ]);

      allow delete: if isValidId(assignmentId) && isVerifiedUser() && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // /completions/{completionId}
    // -------------------------------------------------------------------------
    match /completions/{completionId} {
      allow get: if isSignedIn() && isValidId(completionId) && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid || resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(completionId)
        && isValidCompletionEvent(incoming(), completionId)
        && incoming().clientUserId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/assignments/$(incoming().assignmentId))
        && get(/databases/$(database)/documents/assignments/$(incoming().assignmentId)).data.clientUserId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(completionId)
        && isValidCompletionEvent(incoming(), completionId)
        && existing().clientUserId == request.auth.uid
        && incoming().id == existing().id
        && incoming().assignmentId == existing().assignmentId
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().trainerUserId == existing().trainerUserId
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['loggedValue', 'notes', 'updatedAt']);

      allow delete: if isValidId(completionId) && isVerifiedUser() && existing().clientUserId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // /dailyActivity/{activityId} & /streaks/{clientId}
    // -------------------------------------------------------------------------
    match /dailyActivity/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && (
        existing().clientUserId == request.auth.uid || existing().trainerUserId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientUserId == request.auth.uid || resource.data.trainerUserId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(activityId)
        && isValidDailyActivity(incoming(), activityId)
        && incoming().clientUserId == request.auth.uid
        && (!('recoveryApproved' in incoming()) || incoming().recoveryApproved == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(activityId)
        && isValidDailyActivity(incoming(), activityId)
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().clientUserId == existing().clientUserId
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().clientUserId == request.auth.uid &&
