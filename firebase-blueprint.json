    "User": {
      "title": "User",
      "description": "Core authenticated user profile metadata (no PII stored directly on this document).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["client", "trainer"]
        },
        "timezone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "locale": {
          "type": "string",
          "enum": ["en-IN"]
        },
        "isAdultConfirmed": {
          "type": "boolean"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "role",
        "timezone",
        "locale",
        "isAdultConfirmed",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII document storing user email and private preferences under users/{userId}/private/{docId}.",
      "type": "object",
