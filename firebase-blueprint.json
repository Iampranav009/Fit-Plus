{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core authenticated user profile metadata (no PII stored directly on this document).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "enum": ["client", "trainer", "admin"] },
        "timezone": { "type": "string", "minLength": 2, "maxLength": 64 },
        "locale": { "type": "string", "enum": ["en-IN"] },
        "isAdultConfirmed": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "privacyConsentAccepted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "firstName", "lastName", "role", "timezone", "locale",
        "isAdultConfirmed", "onboardingCompleted", "createdAt", "updatedAt"
      ]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII document storing user email and private preferences under users/{userId}/private/{docId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "whatsappE164": { "type": "string", "maxLength": 20 },
        "celebratedDateKeys": { "type": "array", "description": "Bounded list of YYYY-MM-DD celebration keys (max 365)." },
        "pendingInviteToken": { "type": "string", "maxLength": 64 },
        "notificationPrefs": { "type": "object", "description": "In-app and optional FCM notification preferences." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "celebratedDateKeys", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-provisioned platform administrator membership document (never writable from client SDK).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "TrainerProfile": {
      "title": "TrainerProfile",
      "description": "Public independent coach storefront profile (strictly free of private email/home address PII).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "headline": { "type": "string", "minLength": 1, "maxLength": 180 },
        "bio": { "type": "string", "maxLength": 1200 },
        "coachingStyle": { "type": "string", "maxLength": 600 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "coachingMode": { "type": "string", "enum": ["online", "in_person", "hybrid"] },
        "specialties": { "type": "array", "description": "Bounded list of coaching specialties (max 10)." },
        "languages": { "type": "array", "description": "Bounded list of spoken languages (max 10)." },
        "certifications": { "type": "array", "description": "Bounded list of declared qualifications (max 10)." },
        "experienceYears": { "type": "number" },
        "avatarKey": { "type": "string", "maxLength": 64 },
        "coverKey": { "type": "string", "maxLength": 64 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "whatsappBusinessE164": { "type": "string", "maxLength": 20 },
        "verificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified"] },
        "isDemoVerified": { "type": "boolean", "description": "System-only legacy flag; forced false on client writes." },
        "acceptingClients": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "slug", "displayName", "headline", "bio", "coachingStyle",
        "city", "coachingMode", "specialties", "languages", "experienceYears",
        "avatarKey", "coverKey", "isDemoVerified", "acceptingClients", "createdAt", "updatedAt"
      ]
    },
    "Package": {
      "title": "Package",
      "description": "Coach-published INR coaching package.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trainerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trainerUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "priceInr": { "type": "number" },
        "cadence": { "type": "string", "enum": ["monthly", "quarterly", "free"] },
        "durationDays": { "type": "number" },
        "consultationsIncluded": { "type": "number" },
        "features": { "type": "array", "description": "Bounded list of package features (max 10)." },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "isDemoSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "trainerId", "trainerUserId", "name", "summary", "priceInr",
        "cadence", "features", "status", "isDemoSample", "createdAt", "updatedAt"
      ]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "Client fitness profile, training context, dietary/allergy notes, and active relationship pointer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "maxLength": 80 },
        "age": { "type": "number" },
        "heightCm": { "type": "number" },
