  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Core non-PII user metadata scoped strictly to the owning Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateContact" },
      "description": "Isolated PII (email) and private session state strictly readable and writable by the owning user."
    },
    "/trainers/{trainerId}": {
      "schema": { "$ref": "#/entities/TrainerProfile" },
      "description": "Public independent trainer storefront profiles (no private PII)."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/Package" },
      "description": "INR coaching packages published by trainers."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientProfile" },
      "description": "Client profiles accessible only by the owning client and their actively linked trainer."
    },
    "/relationships/{relationshipId}": {
      "schema": { "$ref": "#/entities/CoachingRelationship" },
      "description": "Coaching relationships linking a client and trainer after explicit acceptance."
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Trainer-created invitation tokens with active/redeemed/revoked lifecycle."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Client enrollments into trainer packages."
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/TaskTemplate" },
      "description": "Reusable trainer task templates."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Daily commitments scheduled for a client."
    },
    "/completions/{completionId}": {
      "schema": { "$ref": "#/entities/CompletionEvent" },
      "description": "Assignment completion logs used to derive streaks and adherence."
    },
    "/progressEvents/{eventId}": {
      "schema": { "$ref": "#/entities/ProgressEvent" },
      "description": "Client progress measurements (weight, strength, waist, steps)."
    },
    "/workoutPlans/{planId}": {
      "schema": { "$ref": "#/entities/WorkoutPlan" },
      "description": "Client weekly workout plans."
    },
    "/mealPlans/{planId}": {
      "schema": { "$ref": "#/entities/MealPlan" },
      "description": "Client India-first meal plans."
    },
    "/consultationSlots/{slotId}": {
      "schema": { "$ref": "#/entities/ConsultationSlot" },
      "description": "Trainer consultation slots with atomic booking sync."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Client-trainer consultation bookings atomically linked to slots."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    },
    "/aiDrafts/{draftId}": {
      "schema": { "$ref": "#/entities/AIPlanDraft" },
      "description": "Trainer-owned AI plan drafts."
    }
  }
}
