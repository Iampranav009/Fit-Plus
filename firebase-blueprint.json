      "description": "Assignment completion logs used to derive streaks and adherence."
    },
    "/dailyActivity/{activityId}": {
      "schema": { "$ref": "#/entities/DailyActivity" },
      "description": "Persistent daily hydration, steps, and recovery records."
    },
    "/streaks/{clientId}": {
      "schema": { "$ref": "#/entities/StreakRecord" },
      "description": "Persistent client streak summary synchronized with completion history."
    },
    "/progressEvents/{eventId}": {
      "schema": { "$ref": "#/entities/ProgressEvent" },
      "description": "Client progress measurements, check-ins, and optional private photo references."
    },
    "/workoutPlans/{planId}": {
      "schema": { "$ref": "#/entities/WorkoutPlan" },
      "description": "Client weekly workout plans."
    },
    "/mealPlans/{planId}": {
      "schema": { "$ref": "#/entities/MealPlan" },
      "description": "Client India-first meal plans."
    },
    "/consultationSlots/{slotId}": {
