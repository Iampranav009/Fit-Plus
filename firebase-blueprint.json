      "description": "Server-controlled package entitlement state."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Server-verified payment & invoice records."
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/TaskTemplate" },
      "description": "Reusable trainer task templates."
    },
    "/assignments/{assignmentId}": {
