        "experienceLevel": { "type": "string", "enum": ["beginner", "intermediate", "experienced"] },
        "daysPerWeek": { "type": "number" },
        "environment": { "type": "string", "enum": ["gym", "home", "outdoors"] },
        "equipment": { "type": "array", "description": "Bounded list of available equipment (max 15)." },
        "dietaryPreference": { "type": "string", "enum": ["vegetarian", "vegan", "non_vegetarian", "other", "prefer_not_to_say"] },
        "dietaryNotes": { "type": "string", "maxLength": 500 },
        "foodAllergies": { "type": "string", "maxLength": 400 },
        "healthLimitations": { "type": "string", "maxLength": 600 },
        "preferredLanguage": { "type": "string", "maxLength": 40 },
        "coachingPreferences": { "type": "string", "maxLength": 500 },
        "coachNotes": { "type": "string", "maxLength": 2000 },
        "activeTrainerUserId": { "type": "string", "maxLength": 128 },
        "activeRelationshipId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "firstName", "lastName", "primaryGoal", "experienceLevel",
        "daysPerWeek", "environment", "equipment", "dietaryPreference",
        "activeTrainerUserId", "activeRelationshipId", "createdAt", "updatedAt"
      ]
    },
    "CoachingRelationship": {
      "title": "CoachingRelationship",
