# FitPlus Production Environment Variables
# Copy to .env.local for local development or configure in Vercel Project Settings.
# NEVER commit real secrets to version control.

# Server-side Gemini AI key (Stage 3B — never prefix with VITE_)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Public application URL (Vercel sets VERCEL_URL automatically; set APP_URL for canonical links)
APP_URL="https://fitplus-kappa.vercel.app"

# Firebase Admin SDK (server-side /api/* token verification & privileged writes)
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON (minified JSON or base64) OR the three individual fields below:
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID="gen-lang-client-0381020502"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-fitplus-848bd738-a0f2-48f4-9c61-6e832da89841"

# Firebase App Check (optional client reCAPTCHA v3 site key & server enforcement flag)
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=""
REQUIRE_APP_CHECK="false"

# Razorpay Test / Live Credentials (Stage 3C — server-side secret never prefixed with VITE_)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_LIVE_ENABLED="false"

# Platform Admin Bootstrap Email (verified email checked in server endpoints alongside /admins/{uid})
FITPLUS_ADMIN_EMAIL="pranavshindeji5001@gmail.com"
